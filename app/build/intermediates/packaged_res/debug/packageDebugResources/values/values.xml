<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="lavender">#E8E4F5</color>
    <color name="lavender_light">#F3F1FA</color>
    <color name="lavender_mid">#B8AEE0</color>
    <color name="orange">#F5B731</color>
    <color name="purple">#5B49A6</color>
    <color name="purple_dark">#4A3A8C</color>
    <color name="text_dark">#2B2250</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Alpatack</string>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/purple_dark</item>
        <item name="android:textColorHint">@color/lavender_mid</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/purple</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="PillLight" parent="Pill">
        <item name="android:background">@drawable/bg_btn_light</item>
        <item name="android:textColor">@color/purple</item>
    </style>
    <style name="Theme.Alpatack" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorAccent">@color/purple</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
</resources>