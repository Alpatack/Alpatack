<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/purple">
    <ImageView android:layout_width="380dp" android:layout_height="420dp" android:layout_gravity="bottom|start" android:layout_marginLeft="-90dp" android:layout_marginBottom="-30dp" android:alpha="0.1" android:scaleType="fitCenter" android:src="@drawable/logo_white" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
        <include layout="@layout/include_header"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:orientation="vertical" android:background="@drawable/bg_group" android:padding="12dp" android:paddingBottom="16dp">
            <TextView style="@style/SettingsLabel" android:layout_marginTop="0dp" android:text="ENTER CURRENT PASSWORD"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/etCurrent" style="@style/SettingsField" android:hint="" android:inputType="textPassword" android:paddingRight="44dp"/>
                <ImageView android:id="@+id/eyeCurrent" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="end|center_vertical" android:padding="11dp" android:src="@drawable/ic_eye_off" android:contentDescription="Show or hide password"/>
            </FrameLayout>
            <TextView style="@style/SettingsLabel" android:text="ENTER NEW PASSWORD"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/etNew" style="@style/SettingsField" android:hint="(must contain at least 8 characters)" android:inputType="textPassword" android:paddingRight="44dp"/>
                <ImageView android:id="@+id/eyeNew" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="end|center_vertical" android:padding="11dp" android:src="@drawable/ic_eye_off" android:contentDescription="Show or hide password"/>
            </FrameLayout>
            <TextView style="@style/SettingsLabel" android:text="RE-ENTER NEW PASSWORD"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/etConfirm" style="@style/SettingsField" android:hint="(password should match the new password)" android:inputType="textPassword" android:paddingRight="44dp"/>
                <ImageView android:id="@+id/eyeConfirm" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="end|center_vertical" android:padding="11dp" android:src="@drawable/ic_eye_off" android:contentDescription="Show or hide password"/>
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/btnSave" style="@style/SaveBtn" android:layout_gravity="center_horizontal" android:layout_marginTop="50dp"/>
    </LinearLayout>
</FrameLayout>
