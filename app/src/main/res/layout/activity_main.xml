<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="@color/white">
    <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_gravity="bottom" android:layout_margin="16dp" android:elevation="8dp"
        android:background="@drawable/bg_nav" android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/nav0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="18dp" android:contentDescription="Home"/>
        <ImageView android:id="@+id/nav1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="18dp" android:contentDescription="Quests"/>
        <ImageView android:id="@+id/nav2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="18dp" android:contentDescription="Achievements"/>
        <ImageView android:id="@+id/nav3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="18dp" android:contentDescription="Shop"/>
        <ImageView android:id="@+id/nav4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="18dp" android:contentDescription="Profile"/>
    </LinearLayout>
</FrameLayout>
