<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/purple">
    <ImageView android:layout_width="380dp" android:layout_height="420dp" android:layout_gravity="bottom|start" android:layout_marginLeft="-90dp" android:layout_marginBottom="-30dp" android:alpha="0.1" android:scaleType="fitCenter" android:src="@drawable/logo_white" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
        <include layout="@layout/include_header"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:orientation="vertical" android:background="@drawable/bg_group" android:padding="8dp">
            <include android:id="@+id/rowProfile" layout="@layout/item_setting_row"/>
            <include android:id="@+id/rowContact" layout="@layout/item_setting_row"/>
            <include android:id="@+id/rowPassword" layout="@layout/item_setting_row"/>
        </LinearLayout>
        <TextView android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="90dp" android:padding="14dp" android:text="Delete Account" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
