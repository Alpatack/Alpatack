<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/purple">
    <ImageView android:layout_width="380dp" android:layout_height="420dp" android:layout_gravity="bottom|start" android:layout_marginLeft="-90dp" android:layout_marginBottom="-30dp" android:alpha="0.1" android:scaleType="fitCenter" android:src="@drawable/logo_white" android:importantForAccessibility="no"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:id="@+id/settingsLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="24dp">
            <include layout="@layout/include_header"/>
            <TextView style="@style/SectionTitle" android:layout_marginTop="36dp" android:text="Account"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_group" android:padding="8dp">
                <include android:id="@+id/rowManage" layout="@layout/item_setting_row"/>
            </LinearLayout>
            <TextView style="@style/SectionTitle" android:text="Notifications"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_group" android:padding="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:elevation="2dp" android:gravity="center_vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Push Notifications" android:textColor="@color/purple_dark" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Allow the app to send alerts and reminders to your device" android:textColor="@color/purple" android:textSize="9sp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPush" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp"
                        app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"/>
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/SectionTitle" android:text="Other"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_group" android:padding="8dp">
                <include android:id="@+id/rowTerms" layout="@layout/item_setting_row"/>
                <include android:id="@+id/rowPrivacy" layout="@layout/item_setting_row"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="32dp"/>
            <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:textColor="@color/lavender_mid" android:textSize="10sp"/>
            <TextView android:id="@+id/btnLogout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:padding="14dp" android:text="Log Out" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
