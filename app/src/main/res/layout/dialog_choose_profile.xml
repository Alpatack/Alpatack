<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_white" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose Profile" android:textColor="@color/purple" android:textSize="16sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/pGallery" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_gallery" android:contentDescription="Choose from gallery"/>
        <ImageView android:id="@+id/p1" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_alpaca_1" android:contentDescription="Alpaca avatar"/>
        <ImageView android:id="@+id/p2" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_alpaca_2" android:contentDescription="Alpaca avatar"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/p3" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_alpaca_3" android:contentDescription="Alpaca avatar"/>
        <ImageView android:id="@+id/p4" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_alpaca_4" android:contentDescription="Alpaca avatar"/>
        <ImageView android:id="@+id/p5" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="6dp" android:padding="3dp" android:background="@drawable/bg_avatar_idle" android:src="@drawable/avatar_alpaca_5" android:contentDescription="Alpaca avatar"/>
    </LinearLayout>
    <TextView android:id="@+id/btnDone" style="@style/Pill" android:layout_marginTop="16dp" android:paddingLeft="32dp" android:paddingRight="32dp" android:text="Done" android:textSize="14sp"/>
</LinearLayout>
