<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_white" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Are you sure you want to delete your account?" android:textColor="@color/purple" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/btnConfirm" style="@style/Pill" android:layout_marginTop="20dp" android:text="Delete Account" android:textSize="12sp"/>
    <TextView android:id="@+id/btnCancel" style="@style/PillLight" android:layout_marginTop="10dp" android:background="@drawable/bg_btn_light_outline" android:text="Cancel" android:textSize="12sp" android:paddingLeft="28dp" android:paddingRight="28dp"/>
</LinearLayout>
