<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:clipToPadding="false" android:paddingBottom="110dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_sparkle"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="4dp"
                android:text="Quest" android:textColor="@color/purple" android:textSize="30sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_btn_light" android:gravity="center_vertical" android:padding="6dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_flame"/>
                <TextView android:id="@+id/tvStreak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:textColor="@color/purple" android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="My Quests" android:textColor="@color/purple" android:textSize="15sp"/>
            <TextView android:id="@+id/btnAdd" style="@style/Pill" android:text="+" android:textSize="20sp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/llQuests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp"
            android:text="No quests yet. Tap + to add one." android:textColor="@color/purple" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
