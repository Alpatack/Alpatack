<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
    android:background="@drawable/bg_row" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="12dp"
    android:clickable="true" android:focusable="true" android:elevation="2dp">
    <TextView android:id="@+id/tvRowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/purple_dark" android:textSize="12sp" android:textStyle="bold"/>
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron"/>
</LinearLayout>
