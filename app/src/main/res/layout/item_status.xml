<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
    android:background="@drawable/bg_card_white" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
    <ImageView android:id="@+id/ivIcon" android:layout_width="22dp" android:layout_height="22dp"/>
    <TextView android:id="@+id/tvText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="@color/purple_dark" android:textSize="12sp" android:minWidth="132dp"/>
    <ProgressBar android:id="@+id/barCat" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="10dp" android:layout_marginLeft="10dp" android:progressDrawable="@drawable/bg_progress"/>
</LinearLayout>
